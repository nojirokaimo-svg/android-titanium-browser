+TEST(DarkModeFilterTest, KiwiPresetsParseAndKeepUpstreamDefaults) {
+  const auto defaults = BuildDarkModeSettingsForTesting("");
+  EXPECT_FLOAT_EQ(110.0f, defaults.lab_lightness_pivot);
+  EXPECT_FLOAT_EQ(0.0f, defaults.image_grayscale_percent);
+  struct Preset { const char* value; float pivot; float grayscale; bool text; };
+  const Preset presets[] = {
+      {"ContrastPercent=0,ImageGrayScalePercent=0.15", 100, .15f, false},
+      {"ContrastPercent=0,ImageGrayScalePercent=0.15", 100, .15f, false},
+      {"ContrastPercent=0,ImageGrayScalePercent=1", 100, 1, false},
+      {"ContrastPercent=0.15,ImageGrayScalePercent=0.15", 115, .15f, false},
+      {"ContrastPercent=0.15,ImageGrayScalePercent=1", 115, 1, false},
+      {"ContrastPercent=-0.15,ImageGrayScalePercent=0.15,IncreaseTextContrast=1",
+       85, .15f, true},
+  };
+  for (const auto& preset : presets) {
+    const auto settings = BuildDarkModeSettingsForTesting(preset.value);
+    EXPECT_FLOAT_EQ(preset.pivot, settings.lab_lightness_pivot);
+    EXPECT_FLOAT_EQ(preset.grayscale, settings.image_grayscale_percent);
+    EXPECT_EQ(preset.text, settings.increase_text_contrast);
+  }
+  const auto invalid = BuildDarkModeSettingsForTesting(
+      "ContrastPercent=nan,ImageGrayScalePercent=inf");
+  EXPECT_FLOAT_EQ(defaults.lab_lightness_pivot, invalid.lab_lightness_pivot);
+  EXPECT_FLOAT_EQ(defaults.image_grayscale_percent, invalid.image_grayscale_percent);
+}
+
+TEST(DarkModeFilterTest, KiwiHighContrastAdjustsForegroundOnBothBackgrounds) {
+  DarkModeSettings settings;
+  settings.increase_text_contrast = true;
+  const auto filter = DarkModeColorFilter::Create(settings);
+  const SkColor4f gray{.5f, .5f, .5f, 1};
+  for (const auto background : {SkColors::kBlack, SkColors::kWhite}) {
+    const auto result = filter->AdjustTextContrast(gray, background);
+    EXPECT_GE(color_utils::GetContrastRatio(result, background), 4.5f);
+    EXPECT_FLOAT_EQ(gray.fA, result.fA);
+  }
+  EXPECT_EQ(SkColors::kTransparent,
+            filter->AdjustTextContrast(SkColors::kTransparent, SkColors::kBlack));
+  settings.increase_text_contrast = false;
+  EXPECT_EQ(gray, DarkModeColorFilter::Create(settings)->AdjustTextContrast(
+                      gray, SkColors::kWhite));
+}
